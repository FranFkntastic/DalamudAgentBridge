<Project>
  <Import Project="eng/Franthropy.Version.props" />
  <PropertyGroup>
    <FranthropySource Condition="'$(FranthropySource)' == ''">Package</FranthropySource>
    <FranthropyFeed Condition="'$(FranthropyFeed)' == ''">$(LOCALAPPDATA)/Franthropy/packages</FranthropyFeed>
    <RestoreAdditionalProjectSources Condition="'$(FranthropySource)' == 'Package'">$(RestoreAdditionalProjectSources);$(FranthropyFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
